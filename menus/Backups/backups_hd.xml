<screen name="BackupsScreen" position="0,0" size="1280,720" title="Backups Panel" flags="wfNoBorder" backgroundColor="transparent">
    
    <!-- Background -->
    <ePixmap position="0,0" zPosition="-1" size="1280,720"
        pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"/>

    <!-- Top black bar -->
    <eLabel position="0,0" size="1280,87" zPosition="10" backgroundColor="#000000" />

    <!-- Title -->
    <eLabel text="● Images backups"
        position="100,0" size="933,33" zPosition="11"
        font="Bold;21" halign="left" valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- LIVE STATUS COUNTER -->
    <widget name="dep_status"
        position="100,47" size="933,33" zPosition="11"
        font="Bold;19" halign="left" valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Bottom color bars -->
    <eLabel position="0,717" size="320,3" backgroundColor="red"/>
    <widget name="red"
        position="0,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Stop installation"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="320,717" size="320,3" backgroundColor="green"/>
    <widget name="green"
        position="320,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Install"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="640,717" size="320,3" backgroundColor="#E6BE3A"/>
    <widget name="yellow"
        position="640,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Show N/A"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="960,717" size="320,3" backgroundColor="blue"/>
    <widget name="blue"
        position="960,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Rescan"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <!-- Side bars -->
    <eLabel position="0,87" size="53,580" zPosition="10" backgroundColor="#000000" />
    <eLabel position="1227,87" size="53,580" zPosition="10" backgroundColor="#000000" />

    <!-- Deps list -->
    <widget name="deps_text"
        position="100,120" size="733,453" zPosition="12"
        font="Bold;21" halign="left" valign="top"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Current installing / Reboot Message -->
    <widget name="current_install"
        position="100,587" size="733,33" zPosition="20"
        font="Bold;19" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

    <!-- Temporary stop message -->
    <widget name="stop_msg"
        position="100,587" size="733,33" zPosition="20"
        font="Bold;19" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

    <!-- STATIC PREFIX LABEL -->
    <widget name="supported_images_static"
        position="100,627" size="180,33" zPosition="15"
        font="Bold;20" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

    <!-- SCROLLING IMAGES TICKER -->
    <widget source="supported_images_list"
        render="RunningText"
        position="280,627" size="553,33" zPosition="15"
        font="Bold;20" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1"
        options="movetype=running,startpoint=0,direction=left,steptime=40,repeat=0,startdelay=1000,nowrap" />

    <!-- System Info -->
    <!-- DATE -->
    <widget source="global.CurrentTime" render="Label"
        position="848,80"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %A %d %B</convert>
    </widget>

    <!-- CLOCK -->
    <widget source="global.CurrentTime" render="Label"
        position="848,107"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %H:%M:%S</convert>
    </widget>

    <!-- Top separator -->
    <eLabel position="913,143"
        size="233,1"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- MiniTV -->
    <widget source="session.VideoPicture"
        render="Pig"
        position="848,157"
        size="367,193"
        zPosition="1"
        backgroundColor="transparent" />

    <!-- Bottom separator -->
    <eLabel position="913,363"
        size="233,1"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- System Information -->
    <widget name="image_name"
        position="848,380"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="python_ver"
        position="848,407"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="local_ip"
        position="848,433"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="StorageInfo"
        position="848,460"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="RAMInfo"
        position="848,487"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="net_status"
        position="848,513"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Vertical text -->
    <widget name="left_bar"
        position="7,107" size="40,507" zPosition="20"
        font="Regular;17" halign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="right_bar"
        position="1233,107" size="40,507" zPosition="20"
        font="Regular;17" halign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

</screen>
