    <!-- Vertical Bars -->
    <widget name="left_bar"
        position="7,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />

    <widget name="right_bar"
        position="1233,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />
</screen>
