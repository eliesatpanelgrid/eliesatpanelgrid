<screen name="News" position="0,0" size="1280,720" backgroundColor="transparent" flags="wfNoBorder" title="Info">
    <ePixmap position="0,0" zPosition="-1" size="1280,720"
        pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"/>

    <!-- Top black bar -->
    <eLabel position="0,0" size="1280,87" zPosition="10" backgroundColor="#000000" />

    <!-- Title -->
    <eLabel text="● Addons update news."
        position="100,23" size="933,33" zPosition="11"
        font="Bold;21" halign="left" valign="center" noWrap="1"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <!-- Left / Right bars -->
    <eLabel position="0,87" size="53,580" zPosition="10" backgroundColor="#000000" />
    <eLabel position="1227,87" size="53,580" zPosition="10" backgroundColor="#000000" />

    <!-- Stay Tuned -->
    <eLabel text="Stay Tuned..."
        position="100,93"
        size="733,23"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        backgroundColor="transparent"
        transparent="1" />

    <!-- Scrollable GitHub Text -->
    <widget name="github_text"
        position="100,120"
        size="733,400"
        zPosition="12"
        font="Bold;21"
        halign="left"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1" />

    <widget name="page_info"
        position="848,627"
        size="367,30"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

    <!-- DATE -->
    <widget source="global.CurrentTime" render="Label"
        position="848,80"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %A %d %B</convert>
    </widget>

    <!-- CLOCK -->
    <widget source="global.CurrentTime" render="Label"
        position="848,107"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %H:%M:%S</convert>
    </widget>

    <!-- Top separator -->
    <eLabel position="913,143"
        size="233,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- MiniTV -->
    <widget source="session.VideoPicture"
        render="Pig"
        position="848,157"
        size="367,193"
        zPosition="1"
        backgroundColor="transparent" />

    <!-- Bottom separator -->
    <eLabel position="913,363"
        size="233,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- System Information -->
    <widget name="image_name"
        position="848,380"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="python_ver"
        position="848,407"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="local_ip"
        position="848,433"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="StorageInfo"
        position="848,460"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="RAMInfo"
