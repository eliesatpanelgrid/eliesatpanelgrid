<screen name="OscamReadersScreen" position="center,center" size="1920,1080">

<ePixmap position="0,0" size="1920,1080"
    pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"
    zPosition="-10"/>

<eLabel position="0,0" size="1920,130"
    backgroundColor="#000000"
    zPosition="10"/>

    <!-- Top black bar -->
    <eLabel position="0,0" size="1920,130" zPosition="10" backgroundColor="#000000" />

    <!-- Title -->
<eLabel text="● Readers manager"
        position="150,35" size="1400,50" zPosition="11"
        font="Bold;32"
        halign="left"
        valign="center"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

<eLabel text="LABEL                    │ ADDRESS                   │ PORT     │ PROTOCOL     │ STATUS"
    position="100,150" size="1740,40"
    font="Console;30"
    foregroundColor="#FF8C00"/>

<eLabel text="────────────────────────────────────────────────────────────────────────────────────────────────────────────"
    position="100,188" size="1740,40"
    font="Console;30"
    foregroundColor="#E6BE3A"/>

<!-- LIST -->
<widget name="list"
        position="100,225"
        size="1740,600"
        itemHeight="60"
        font="Console;30"
        foregroundColor="#E6BE3A"
        foregroundColorSelected="#FF8C00"
        backgroundColor="background"
        selectionPixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/icon/selection.png"
        transparent="1"
        scrollbarMode="showOnDemand" alphatest="blend"/>

<widget name="error"
    position="0,225"
    size="1920,625"
    font="Bold;44"
    halign="center"
    valign="center"
    foregroundColor="#FF0000"
    transparent="1"/>

<widget name="title"
    position="0,950"
    size="1920,50"
    font="Bold;28"
    halign="center"
    backgroundColor="background"
    foregroundColor="#FF8C00"
    transparent="1" alphatest="blend"/>

    <!-- Bottom Buttons -->

    <eLabel position="0,1075" size="480,5" backgroundColor="red" />
    <widget name="red"
        position="0,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Remove Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="480,1075" size="480,5" backgroundColor="green" />
    <widget name="green"
        position="480,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Enable/Disable Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="960,1075" size="480,5" backgroundColor="#E6BE3A" />
    <widget name="yellow"
        position="960,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Edit Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="1440,1075" size="480,5" backgroundColor="blue" />
    <widget name="blue"
        position="1440,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Restore Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <!-- Side Bars -->
    <eLabel position="0,130"
        size="80,870"
        zPosition="10"
        backgroundColor="#000000" />

    <eLabel position="1840,130"
        size="80,870"
        zPosition="10"
        backgroundColor="#000000" />

    <!-- Vertical Bars -->
    <widget name="left_bar"
        position="10,160"
        size="60,760"
        zPosition="20"
        font="Regular;26"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />

    <widget name="right_bar"
        position="1850,160"
        size="60,760"
        zPosition="20"
        font="Regular;26"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />

</screen>
