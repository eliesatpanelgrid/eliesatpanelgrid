<screen name="ProtocolEditorScreen" position="0,0" size="1280,720" backgroundColor="transparent">

    <!-- Background -->
    <ePixmap position="0,0" zPosition="-1" size="1280,720"
        pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"/>

    <!-- Top bar -->
    <eLabel position="0,0" size="1280,86" zPosition="10" backgroundColor="#000000" />

    <eLabel text="● Subscription Editor"
        position="100,23" size="933,34" zPosition="11"
        font="Bold;21" halign="left" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <!-- Bottom buttons -->
    <eLabel position="0,717" size="320,3" zPosition="2" backgroundColor="red" />
    <widget name="red" position="0,667" size="320,50" zPosition="2"
        font="Bold;21" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="320,717" size="320,3" zPosition="2" backgroundColor="green" />
    <widget name="green" position="320,667" size="320,50" zPosition="2"
        font="Bold;21" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="640,717" size="320,3" zPosition="2" backgroundColor="#E6BE3A" />
    <widget name="yellow" position="640,667" size="320,50" zPosition="2"
        font="Bold;21" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="960,717" size="320,3" zPosition="2" backgroundColor="blue" />
    <widget name="blue" position="960,667" size="320,50" zPosition="2"
        font="Bold;21" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <!-- Side bars -->
    <eLabel position="0,86" size="53,581" zPosition="10" backgroundColor="#000000" />
    <eLabel position="1227,86" size="53,581" zPosition="10" backgroundColor="#000000" />

    <!-- Header -->
    <eLabel text="New Reader..."
        position="100,93"
        size="733,23"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        backgroundColor="transparent"
        transparent="1" />

    <!-- DATE -->
    <widget source="global.CurrentTime" render="Label"
        position="848,80"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %A %d %B</convert>
    </widget>

    <!-- CLOCK -->
    <widget source="global.CurrentTime" render="Label"
        position="848,107"
        size="367,27"
        zPosition="12"
        font="Bold;21"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %H:%M:%S</convert>
    </widget>

    <!-- Top separator -->
    <eLabel position="913,143"
        size="233,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- MiniTV -->
    <widget source="session.VideoPicture"
        render="Pig"
        position="848,157"
        size="367,193"
        zPosition="1"
        backgroundColor="transparent" />

    <!-- Bottom separator -->
    <eLabel position="913,363"
        size="233,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- System Information -->
    <widget name="image_name"
        position="848,380"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="python_ver"
        position="848,407"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="local_ip"
        position="848,434"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="StorageInfo"
        position="848,461"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="RAMInfo"
        position="848,488"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="net_status"
        position="848,515"
        size="367,23"
        zPosition="12"
        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Config list -->
    <widget name="config"
        position="100,120"
        size="733,600"
        font="Bold;21"
        itemHeight="33"
        foregroundColor="#E6BE3A"
        transparent="1"
        scrollbarMode="showOnDemand"
        enableWrapAround="1"
        valign="center"
        selectionPixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/icon/selection.png" />

    <!-- Vertical texts -->
    <widget name="left_bar"
        position="7,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        noWrap="1"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="0" />

    <widget name="right_bar"
        position="1233,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        noWrap="1"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="0" />

</screen>
