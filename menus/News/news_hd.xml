        font="Bold;20"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Bottom Buttons -->
    <eLabel position="0,717" size="320,3" backgroundColor="red" />
    <widget name="red"
        position="0,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Remove List"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="320,717" size="320,3" backgroundColor="green" />
