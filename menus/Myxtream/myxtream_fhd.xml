<screen name="MyXtreamCategories" position="0,0" size="1920,1080" title="MyXtream" flags="wfNoBorder">
    <eLabel position="0,0" size="1920,130" zPosition="10" backgroundColor="#000000" />
    <ePixmap pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg" position="0,0" size="1920,1080" zPosition="-1"/>
    
    <eLabel text="● Myxtream Bouquets list..."
        position="150,35"
        size="1400,50"
        zPosition="11"
        font="Bold;32"
        halign="left"
        valign="center"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1" />
        
    <widget name ="title"
        position="150,140" 
        size="1100,35" 
        zPosition="12"
        font="Bold;32"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        backgroundColor="transparent" />
        
    <widget name="list" position="150,180" size="1100,700" itemHeight="50" font="Bold;32" foregroundColor="#E6BE3A" foregroundColorSelected="#FF8C00" selectionPixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/icon/selection.png" scrollbarMode="showOnDemand" transparent="1"/>

    <!-- Bottom buttons -->
    <eLabel position="0,1075" size="480,5" zPosition="2" backgroundColor="red" />
    <widget name="red" position="0,1000" size="480,75" zPosition="2"
        font="Bold;32" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="480,1075" size="480,5" zPosition="2" backgroundColor="green" />
    <widget name="green" position="480,1000" size="480,75" zPosition="2"
        font="Bold;32" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="960,1075" size="480,5" zPosition="2" backgroundColor="#E6BE3A" />
    <widget name="yellow" position="960,1000" size="480,75" zPosition="2"
        font="Bold;32" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <eLabel position="1440,1075" size="480,5" zPosition="2" backgroundColor="blue" />
    <widget name="blue" position="1440,1000" size="480,75" zPosition="2"
        font="Bold;32" halign="center" valign="center"
        foregroundColor="#E6BE3A" backgroundColor="#000000"
        transparent="0" />

    <!-- Side bars -->
    <eLabel position="0,130" size="80,870" zPosition="10" backgroundColor="#000000" />
    <eLabel position="1840,130" size="80,870" zPosition="10" backgroundColor="#000000" />

    <!-- System info -->
    <!-- DATE -->
    <widget source="global.CurrentTime" render="Label"
        position="1272,120"
        size="550,40"
        zPosition="12"
        font="Bold;32"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %A %d %B</convert>
    </widget>

    <!-- CLOCK -->
    <widget source="global.CurrentTime" render="Label"
        position="1272,160"
        size="550,40"
        zPosition="12"
        font="Bold;32"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %H:%M:%S</convert>
    </widget>

    <!-- Top separator -->
    <eLabel position="1370,215"
        size="350,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- MiniTV -->
    <widget source="session.VideoPicture"
        render="Pig"
        position="1272,235"
        size="550,290"
        zPosition="1"
        backgroundColor="transparent" />

    <!-- Bottom separator -->
    <eLabel position="1370,545"
        size="350,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- System Information -->
    <widget name="image_name"
        position="1272,570"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="python_ver"
        position="1272,610"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="local_ip"
        position="1272,650"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="StorageInfo"
        position="1272,690"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="RAMInfo"
        position="1272,730"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="net_status"
        position="1272,770"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Left / Right vertical bars -->
    <widget name="left_bar" position="10,160" size="60,760" zPosition="20"
        font="Regular;26" halign="center" valign="top"
        backgroundColor="#000000"
        foregroundColor="#E6BE3A" transparent="1" noWrap="1" />
    <widget name="right_bar" position="1850,160" size="60,760" zPosition="20"
        font="Regular;26" halign="center" valign="top"
        backgroundColor="#000000"
        foregroundColor="#E6BE3A" transparent="1" noWrap="1" />
    </screen>
