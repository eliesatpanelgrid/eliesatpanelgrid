<screen name="OscamReadersScreen" position="center,center" size="1280,720">

    <ePixmap position="0,0" size="1280,720"
        pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"
        zPosition="-10"/>

    <eLabel position="0,0" size="1280,87"
        backgroundColor="#000000"
        zPosition="10"/>

    <!-- Top black bar -->
    <eLabel position="0,0" size="1280,87" zPosition="10" backgroundColor="#000000" />

    <!-- Title -->
    <eLabel text="● Readers manager"
        position="100,23" size="933,33" zPosition="11"
        font="Bold;21"
        halign="left"
        valign="center"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel text="LABEL                    │ ADDRESS                   │ PORT     │ PROTOCOL     │ STATUS"
        position="67,100" size="1160,27"
        font="Console;20"
        foregroundColor="#FF8C00"/>

    <eLabel text="────────────────────────────────────────────────────────────────────────────────────────────────────────────"
        position="67,125" size="1160,27"
        font="Console;20"
        foregroundColor="#E6BE3A"/>

    <!-- LIST -->
    <widget name="list"
        position="67,150"
        size="1160,400"
        itemHeight="40"
        font="Console;20"
        foregroundColor="#E6BE3A"
        foregroundColorSelected="#FF8C00"
        backgroundColor="background"
        selectionPixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/icon/selection.png"
        transparent="1"
        scrollbarMode="showOnDemand"
        alphatest="blend"/>

    <widget name="error"
        position="0,150"
        size="1280,417"
        font="Bold;29"
        halign="center"
        valign="center"
        foregroundColor="#FF0000"
        transparent="1"/>

    <widget name="title"
        position="0,633"
        size="1280,33"
        font="Bold;19"
        halign="center"
        backgroundColor="background"
        foregroundColor="#FF8C00"
        transparent="1"
        alphatest="blend"/>

    <!-- Bottom Buttons -->

    <eLabel position="0,717" size="320,3" backgroundColor="red" />
    <widget name="red"
        position="0,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Remove Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="320,717" size="320,3" backgroundColor="green" />
    <widget name="green"
        position="320,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Enable/Disable Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="640,717" size="320,3" backgroundColor="#E6BE3A" />
    <widget name="yellow"
        position="640,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Edit Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <eLabel position="960,717" size="320,3" backgroundColor="blue" />
    <widget name="blue"
        position="960,667"
        size="320,50"
        font="Bold;21"
        halign="center"
        valign="center"
        text="Restore Reader"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000" />

    <!-- Side Bars -->
    <eLabel position="0,87"
        size="53,580"
        zPosition="10"
        backgroundColor="#000000" />

    <eLabel position="1227,87"
        size="53,580"
        zPosition="10"
        backgroundColor="#000000" />

    <!-- Vertical Bars -->
    <widget name="left_bar"
        position="7,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />

    <widget name="right_bar"
        position="1233,107"
        size="40,507"
        zPosition="20"
        font="Regular;17"
        halign="center"
        valign="top"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"
        transparent="1"
        noWrap="1" />

</screen>
