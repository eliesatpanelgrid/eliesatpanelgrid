<screen name="Backups" position="0,0" size="1920,1080" backgroundColor="transparent" flags="wfNoBorder" title="Smart Dependency Checker">

    <!-- Background -->
    <ePixmap position="0,0" zPosition="-1" size="1920,1080"
        pixmap="/usr/lib/enigma2/python/Plugins/Extensions/ElieSatPanelGrid/assets/background/panel_bg.jpg"/>

    <!-- Top black bar -->
    <eLabel position="0,0" size="1920,130" zPosition="10" backgroundColor="#000000" />

    <!-- Title -->
    <eLabel text="● Images backups"
        position="350,0" size="1400,50" zPosition="11"
        font="Bold;32" halign="left" valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- LIVE STATUS COUNTER -->
    <widget name="dep_status"
        position="350,70" size="1400,50" zPosition="11"
        font="Bold;28" halign="left" valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Bottom color bars -->
    <eLabel position="0,1075" size="480,5" backgroundColor="red"/>
    <widget name="red"
        position="0,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Stop installation"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="480,1075" size="480,5" backgroundColor="green"/>
    <widget name="green"
        position="480,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Install"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="960,1075" size="480,5" backgroundColor="#E6BE3A"/>
    <widget name="yellow"
        position="960,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Show N/A"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <eLabel position="1440,1075" size="480,5" backgroundColor="blue"/>
    <widget name="blue"
        position="1440,1000"
        size="480,75"
        font="Bold;32"
        halign="center"
        valign="center"
        text="Rescan"
        foregroundColor="#E6BE3A"
        backgroundColor="#000000"/>

    <!-- Side bars -->
    <eLabel position="0,130" size="80,870" zPosition="10" backgroundColor="#000000" />
    <eLabel position="1840,130" size="80,870" zPosition="10" backgroundColor="#000000" />

    <!-- Deps list -->
    <widget name="deps_text"
        position="150,180" size="1100,700" zPosition="12"
        font="Bold;32" halign="left" valign="top"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Page info -->
    <widget name="page_info"
        position="1700,940" size="600,60" zPosition="12"
        font="Bold;32" halign="left" valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- System Info -->
    <!-- DATE -->
    <widget source="global.CurrentTime" render="Label"
        position="1272,120"
        size="550,40"
        zPosition="12"
        font="Bold;32"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %A %d %B</convert>
    </widget>

    <!-- CLOCK -->
    <widget source="global.CurrentTime" render="Label"
        position="1272,160"
        size="550,40"
        zPosition="12"
        font="Bold;32"
        halign="center"
        valign="center"
        foregroundColor="#FF8C00"
        transparent="1">
        <convert type="ClockToText">Format %H:%M:%S</convert>
    </widget>

    <!-- Top separator -->
    <eLabel position="1370,215"
        size="350,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- MiniTV -->
    <widget source="session.VideoPicture"
        render="Pig"
        position="1272,235"
        size="550,290"
        zPosition="1"
        backgroundColor="transparent" />

    <!-- Bottom separator -->
    <eLabel position="1370,545"
        size="350,2"
        zPosition="12"
        backgroundColor="#E6BE3A" />

    <!-- System Information -->
    <widget name="image_name"
        position="1272,570"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="python_ver"
        position="1272,610"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="local_ip"
        position="1272,650"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="StorageInfo"
        position="1272,690"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="RAMInfo"
        position="1272,730"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="net_status"
        position="1272,770"
        size="550,35"
        zPosition="12"
        font="Bold;30"
        halign="center"
        valign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Vertical text -->
    <widget name="left_bar"
        position="10,160" size="60,760" zPosition="20"
        font="Regular;26" halign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <widget name="right_bar"
        position="1850,160" size="60,760" zPosition="20"
        font="Regular;26" halign="center"
        foregroundColor="#E6BE3A"
        transparent="1" />

    <!-- Current installing package -->
    <widget name="current_install"
        position="150,900" size="1100,50" zPosition="15"
        font="Bold;32" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

    <!-- Temporary stop message -->
    <widget name="stop_msg"
        position="150,960" size="1100,50" zPosition="15"
        font="Bold;32" halign="left" valign="center"
        foregroundColor="#FF8C00"
        transparent="1" />

</screen>